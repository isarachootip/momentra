# ==============================================================================
# Momentra (HDAM) Environment Configuration
# ==============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql://user:password@localhost:5432/momentra_db?sslmode=disable
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=10

# Security & JWT (Secret must be at least 32 characters)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Logging & Monitoring
LOG_LEVEL=info

# Cross-Origin Resource Sharing
CORS_ORIGIN=*
