{
  "name": "momentra-backend",
  "version": "1.0.0",
  "description": "Momentra (HDAM) Backend - Historical Digital Asset Management Core API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc",
    "build:web": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm --prefix web run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:web"
  },
  "keywords": [
    "momentra",
    "hdam",
    "digital-asset-management",
    "timeline",
    "fastify",
    "postgresql"
  ],
  "author": "Momentra Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^10.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^3.0.8",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
